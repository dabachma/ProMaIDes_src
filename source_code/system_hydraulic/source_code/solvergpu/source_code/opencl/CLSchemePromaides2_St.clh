//#define INERTIAL_SCHEME		1			// Calculated based on sqrt(gh) instead of u + sqrt(gh)
#define DIFFUSIVE_SCHEME 1

// Structure definitions
typedef struct sFaceStructure {
	cl_double4	pN;
	cl_double4	pE;
	cl_double4	pS;
	cl_double4	pW;
} sFaceStructure;

// Structure definitions
typedef struct sUsePolini {
	bool	usePoliniN;
	bool	usePoliniE;
	bool	usePoliniS;
	bool	usePoliniW;
} sUsePolini;

#ifdef USE_FUNCTION_STUBS

// Function definitions
//calculation of the overfow for the four neihgboring elements; it is i decide her if Manning (normal flow) or poleni (weir-flow over 1d-dikeline) is used
__kernel  REQD_WG_SIZE_FULL_TS
void pro2St_cacheDisabled ( 
	__constant	cl_double *,
	__global	cl_double const * restrict,
	__global	cl_double4 *,
	__global	cl_double4 *,
	__global    cl_double const * restrict,
	__global	sUsePolini const * restrict,
	__global	cl_double  const * restrict,
	__global	cl_double  const * restrict,
	__global	cl_double  const * restrict,
	__global	cl_double  const * restrict,
	__global	cl_double4 *,  				// pediction cell state data
	__constant  cl_int *						//prediction (0) or correction mode(1)
);

//calculation the overflow via Manning-equation (normal flow)
cl_double2 manning_Solver(
	cl_double Timestep,
	cl_double manning,
	cl_double manning_Neig,
	cl_double opt_s_Cell,
	cl_double opt_s_Neig,
	cl_double opt_z_Cell,
	cl_double opt_z_Neig,
	cl_double DeltaXY,
	cl_double previous_discharge,
	cl_int mode,
	bool debug
	);
//calculation the overflow between elements via Poleni weir equation (1d-dike line element)
cl_double2 poleni_Solver(
	cl_double Timestep,
	cl_double manning,
	cl_double manning_Neig,
	cl_double opt_s_Cell,
	cl_double opt_s_Neig,
	cl_double opt_z_Cell,
	cl_double opt_z_Neig,
	cl_double opt_zxymax,
	cl_double opt_cxy,
	cl_double DeltaXY,
	cl_double previous_discharge,
	bool debug
	);

#endif